# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace manifests
COPY package.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/design-tokens/package.json ./packages/design-tokens/
COPY apps/api-node/package.json ./apps/api-node/

RUN npm install

COPY tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api-node/ ./apps/api-node/

WORKDIR /app/packages/shared-types
RUN npm run build

WORKDIR /app/packages/design-tokens
RUN npm run build

WORKDIR /app/apps/api-node
RUN npx prisma generate
RUN npm run build

# Stage 2: Runtime
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

# Security: Non-root execution
USER node

COPY --chown=node:node package.json ./
COPY --chown=node:node apps/api-node/package.json ./apps/api-node/
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --chown=node:node --from=builder /app/packages/design-tokens/dist ./packages/design-tokens/dist
COPY --chown=node:node --from=builder /app/apps/api-node/dist ./apps/api-node/dist
COPY --chown=node:node --from=builder /app/apps/api-node/prisma ./apps/api-node/prisma

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/api/health || exit 1

CMD ["node", "apps/api-node/dist/main.js"]
