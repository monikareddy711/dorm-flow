# Multi-stage Dockerfile for React Student Portal
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json ./
COPY packages/ ./packages/
COPY apps/student-portal-react/package.json ./apps/student-portal-react/

RUN npm install

COPY tsconfig.base.json ./
COPY apps/student-portal-react/ ./apps/student-portal-react/

WORKDIR /app/apps/student-portal-react
RUN npm run build

# Nginx runtime stage
FROM nginx:alpine AS runner

COPY infrastructure/docker/nginx.react.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/student-portal-react/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
